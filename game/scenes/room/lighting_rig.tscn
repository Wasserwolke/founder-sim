[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://game/scripts/room/lighting_rig.gd" id="1_lighting"]

[sub_resource type="Shader" id="Shader_exterior"]
code = "shader_type canvas_item;\n\nuniform vec4 tint : source_color = vec4(0.02, 0.05, 0.12, 1.0);\nuniform float darkness : hint_range(0.0, 1.0) = 0.0;\n\nfloat window_mask(vec2 uv) {\n    vec2 min_p = vec2(0.292, 0.050);\n    vec2 max_p = vec2(0.685, 0.497);\n    vec2 local = (uv - min_p) / (max_p - min_p);\n    float inside = step(0.0, local.x) * step(local.x, 1.0) * step(0.0, local.y) * step(local.y, 1.0);\n    float feather_x = smoothstep(0.0, 0.025, local.x) * (1.0 - smoothstep(0.975, 1.0, local.x));\n    float feather_y = smoothstep(0.0, 0.018, local.y) * (1.0 - smoothstep(0.982, 1.0, local.y));\n    return inside * feather_x * feather_y;\n}\n\nvoid fragment() {\n    float mask = window_mask(UV);\n    COLOR = vec4(tint.rgb, darkness * mask);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_exterior"]
resource_local_to_scene = true
shader = SubResource("Shader_exterior")
shader_parameter/tint = Color(0.02, 0.05, 0.12, 1)
shader_parameter/darkness = 0.0

[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;\n\nuniform float strength : hint_range(0.0, 0.5) = 0.08;\n\nvoid fragment() {\n    vec2 p = UV * 2.0 - 1.0;\n    p.x *= 0.82;\n    float edge = smoothstep(0.54, 1.18, length(p));\n    COLOR = vec4(0.006, 0.012, 0.022, edge * strength);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
