[sub_resource type="Shader" id="Shader_room"]
code = "shader_type canvas_item;\nrender_mode blend_add;\n\nuniform vec4 tint : source_color = vec4(1.0, 0.66, 0.36, 1.0);\nuniform float strength : hint_range(0.0, 2.0) = 0.0;\n\nvoid fragment() {\n    vec2 uv = UV;\n    vec2 center = vec2(0.50, 0.34);\n    vec2 scale = vec2(0.92, 0.72);\n    float distance_to_light = length((uv - center) / scale);\n    float glow = 1.0 - smoothstep(0.08, 0.95, distance_to_light);\n    float lower_falloff = 1.0 - smoothstep(0.72, 1.02, uv.y);\n    float intensity = glow * lower_falloff * strength * 0.30;\n    COLOR = vec4(tint.rgb * intensity, intensity);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_room"]
