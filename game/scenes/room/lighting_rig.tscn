[ext_resource type="Script" path="res://game/scripts/room/lighting_rig.gd" id="1_lighting"]

[sub_resource type="Shader" id="Shader_exterior"]
code = "shader_type canvas_item;\n\nuniform vec4 tint : source_color = vec4(0.035, 0.075, 0.14, 1.0);\nuniform float darkness : hint_range(0.0, 1.0) = 0.0;\n\nfloat window_mask(vec2 uv) {\n    vec2 min_p = vec2(0.293, 0.052);\n    vec2 max_p = vec2(0.682, 0.495);\n    vec2 local = (uv - min_p) / (max_p - min_p);\n    float inside = step(0.0, local.x) * step(local.x, 1.0) * step(0.0, local.y) * step(local.y, 1.0);\n    float feather_x = smoothstep(0.0, 0.035, local.x) * (1.0 - smoothstep(0.965, 1.0, local.x));\n    float feather_y = smoothstep(0.0, 0.025, local.y) * (1.0 - smoothstep(0.975, 1.0, local.y));\n    return inside * feather_x * feather_y;\n}\n\nvoid fragment() {\n    float mask = window_mask(UV);\n    COLOR = vec4(tint.rgb, darkness * mask);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_exterior"]
resource_local_to_scene = true
shader = SubResource("Shader_exterior")
shader_parameter/tint = Color(0.035, 0.075, 0.14, 1)
shader_parameter/darkness = 0.0

[sub_resource type="Shader" id="Shader_window"]
code = "shader_type canvas_item;\nrender_mode blend_add;\n\nuniform vec4 tint : source_color = vec4(0.74, 0.86, 1.0, 1.0);\nuniform float strength : hint_range(0.0, 2.0) = 0.0;\n\nvoid fragment() {\n    vec2 uv = UV;\n    vec2 center = vec2(0.487, 0.275);\n    vec2 half_size = vec2(0.195, 0.218);\n    vec2 q = abs(uv - center) / half_size;\n    float window_mask = 1.0 - smoothstep(0.84, 1.08, max(q.x, q.y));\n\n    vec2 halo_scale = vec2(0.34, 0.35);\n    float halo_distance = length((uv - center) / halo_scale);\n    float halo = (1.0 - smoothstep(0.62, 1.08, halo_distance)) * (1.0 - window_mask);\n\n    float intensity = (window_mask * 0.22 + halo * 0.055) * strength;\n    COLOR = vec4(tint.rgb * intensity, intensity);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_window"]
