[sub_resource type="Shader" id="Shader_sun"]
code = "shader_type canvas_item;\nrender_mode blend_add;\n\nuniform vec4 tint : source_color = vec4(1.0, 0.72, 0.40, 1.0);\nuniform float strength : hint_range(0.0, 2.0) = 0.0;\nuniform float shift : hint_range(-0.5, 0.5) = 0.0;\nuniform float slope : hint_range(-1.0, 1.0) = 0.35;\n\nfloat soft_band(float x, float center, float width, float softness) {\n    return 1.0 - smoothstep(width, width + softness, abs(x - center));\n}\n\nvoid fragment() {\n    vec2 uv = UV;\n    float axis = 0.49 + shift + (uv.y - 0.34) * slope;\n\n    float ray_a = soft_band(uv.x, axis - 0.17, 0.035, 0.045) * 0.58;\n    float ray_b = soft_band(uv.x, axis - 0.035, 0.055, 0.055) * 0.82;\n    float ray_c = soft_band(uv.x, axis + 0.16, 0.042, 0.050) * 0.48;\n    float rays = ray_a + ray_b + ray_c;\n\n    float below_window = smoothstep(0.37, 0.49, uv.y);\n    float lower_fade = 1.0 - smoothstep(0.92, 0.995, uv.y);\n    float side_fade = smoothstep(0.08, 0.24, uv.x) * (1.0 - smoothstep(0.78, 0.96, uv.x));\n    float ray_gate = below_window * lower_fade * side_fade;\n\n    float wall_gate = smoothstep(0.36, 0.43, uv.y) * (1.0 - smoothstep(0.64, 0.72, uv.y));\n    float wall_patch = soft_band(uv.x, axis - 0.02, 0.18, 0.11) * wall_gate;\n\n    float floor_gate = smoothstep(0.62, 0.70, uv.y) * (1.0 - smoothstep(0.955, 1.0, uv.y));\n    float floor_axis = 0.50 + shift * 1.22 + (uv.y - 0.63) * slope * 0.58;\n    float floor_patch = soft_band(uv.x, floor_axis, 0.19, 0.12) * floor_gate;\n\n    float intensity = (rays * ray_gate * 0.23 + wall_patch * 0.14 + floor_patch * 0.34) * strength;\n    COLOR = vec4(tint.rgb * intensity, intensity);\n}\n"

