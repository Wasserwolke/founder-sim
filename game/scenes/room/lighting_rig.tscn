[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;\n\nuniform float strength : hint_range(0.0, 0.6) = 0.10;\n\nvoid fragment() {\n    vec2 p = UV * 2.0 - 1.0;\n    p.x *= 0.82;\n    float edge = smoothstep(0.48, 1.18, length(p));\n    COLOR = vec4(0.008, 0.014, 0.024, edge * strength);\n}\n"

