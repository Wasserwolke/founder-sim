[sub_resource type="Shader" id="Shader_city"]
code = "shader_type canvas_item;\nrender_mode blend_add;\n\nuniform float strength : hint_range(0.0, 2.0) = 0.0;\n\nfloat hash21(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\nvoid fragment() {\n    vec2 uv = UV;\n    vec2 min_p = vec2(0.302, 0.105);\n    vec2 max_p = vec2(0.674, 0.486);\n    vec2 local = (uv - min_p) / (max_p - min_p);\n    float inside = step(0.0, local.x) * step(local.x, 1.0) * step(0.0, local.y) * step(local.y, 1.0);\n\n    vec2 grid = vec2(30.0, 18.0);\n    vec2 cell = floor(local * grid);\n    vec2 tile = fract(local * grid);\n    float skyline = 0.26 + hash21(vec2(cell.x, 7.0)) * 0.34;\n    float building = step(skyline, local.y);\n    float pane_x = smoothstep(0.22, 0.31, tile.x) * (1.0 - smoothstep(0.69, 0.78, tile.x));\n    float pane_y = smoothstep(0.20, 0.30, tile.y) * (1.0 - smoothstep(0.70, 0.80, tile.y));\n    float active = step(0.72, hash21(cell + vec2(19.0, 3.0)));\n    float warm_pick = hash21(cell + vec2(2.0, 41.0));\n    vec3 cool = vec3(0.55, 0.72, 1.0);\n    vec3 warm = vec3(1.0, 0.68, 0.28);\n    vec3 color = mix(cool, warm, smoothstep(0.28, 0.72, warm_pick));\n    float breathe = 0.90 + 0.10 * sin(TIME * 0.35 + hash21(cell) * 6.28318);\n    float intensity = inside * building * pane_x * pane_y * active * breathe * strength * 0.34;\n    COLOR = vec4(color * intensity, intensity);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_city"]
