[gd_scene load_steps=16 format=3]

[ext_resource type="Script" path="res://game/scripts/room/lighting_rig.gd" id="1_lighting"]

[sub_resource type="Shader" id="Shader_exterior"]
code = "shader_type canvas_item;\n\nuniform vec4 tint : source_color = vec4(0.025, 0.06, 0.14, 1.0);\nuniform float darkness : hint_range(0.0, 1.0) = 0.0;\n\nfloat window_mask(vec2 uv) {\n    vec2 min_p = vec2(0.293, 0.052);\n    vec2 max_p = vec2(0.682, 0.495);\n    vec2 local = (uv - min_p) / (max_p - min_p);\n    float inside = step(0.0, local.x) * step(local.x, 1.0) * step(0.0, local.y) * step(local.y, 1.0);\n    float feather_x = smoothstep(0.0, 0.025, local.x) * (1.0 - smoothstep(0.975, 1.0, local.x));\n    float feather_y = smoothstep(0.0, 0.018, local.y) * (1.0 - smoothstep(0.982, 1.0, local.y));\n    return inside * feather_x * feather_y;\n}\n\nvoid fragment() {\n    float mask = window_mask(UV);\n    COLOR = vec4(tint.rgb, darkness * mask);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_exterior"]
resource_local_to_scene = true
shader = SubResource("Shader_exterior")
shader_parameter/tint = Color(0.025, 0.06, 0.14, 1)
shader_parameter/darkness = 0.0

[sub_resource type="Shader" id="Shader_window"]
code = "shader_type canvas_item;\nrender_mode blend_add;\n\nuniform vec4 tint : source_color = vec4(0.82, 0.91, 1.0, 1.0);\nuniform float strength : hint_range(0.0, 2.5) = 0.0;\n\nvoid fragment() {\n    vec2 uv = UV;\n    vec2 center = vec2(0.487, 0.275);\n    vec2 half_size = vec2(0.195, 0.218);\n    vec2 q = abs(uv - center) / half_size;\n    float window_mask = 1.0 - smoothstep(0.89, 1.025, max(q.x, q.y));\n    vec2 halo_scale = vec2(0.30, 0.31);\n    float halo_distance = length((uv - center) / halo_scale);\n    float halo = (1.0 - smoothstep(0.64, 1.08, halo_distance)) * (1.0 - window_mask);\n    float sill = smoothstep(0.43, 0.49, uv.y) * (1.0 - smoothstep(0.53, 0.60, uv.y));\n    float intensity = (window_mask * 0.30 + halo * 0.075 + sill * 0.055) * strength;\n    COLOR = vec4(tint.rgb * intensity, clamp(intensity, 0.0, 1.0));\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_window"]
resource_local_to_scene = true
shader = SubResource("Shader_window")
shader_parameter/tint = Color(0.82, 0.91, 1, 1)
shader_parameter/strength = 0.0

[sub_resource type="Shader" id="Shader_sun"]
code = "shader_type canvas_item;\nrender_mode blend_add;\n\nuniform vec4 tint : source_color = vec4(1.0, 0.70, 0.34, 1.0);\nuniform float strength : hint_range(0.0, 3.0) = 0.0;\nuniform float source_shift : hint_range(-0.12, 0.12) = 0.0;\nuniform float travel : hint_range(-1.0, 1.0) = -0.55;\n\nfloat beam_profile(float x, float center, float core_width, float halo_width) {\n    float d = abs(x - center);\n    float core = 1.0 - smoothstep(core_width * 0.30, core_width, d);\n    float halo = 1.0 - smoothstep(core_width, halo_width, d);\n    return core * 2.25 + halo * 0.48;\n}\n\nvoid fragment() {\n    vec2 uv = UV;\n    const float exit_y = 0.485;\n    float below_window = smoothstep(exit_y, exit_y + 0.018, uv.y);\n    float bottom_fade = 1.0 - smoothstep(0.94, 1.0, uv.y);\n    float t = clamp((uv.y - exit_y) / (1.0 - exit_y), 0.0, 1.0);\n\n    float source = 0.487 + source_shift;\n    float drift = travel * t * 0.52;\n    float beam_a = beam_profile(uv.x, source - 0.145 + drift, 0.0026, 0.016);\n    float beam_b = beam_profile(uv.x, source - 0.020 + drift * 0.96, 0.0032, 0.020);\n    float beam_c = beam_profile(uv.x, source + 0.125 + drift * 0.90, 0.0024, 0.015);\n    float beams = (beam_a * 0.86 + beam_b * 1.0 + beam_c * 0.78) * below_window * bottom_fade;\n\n    float floor_gate = smoothstep(0.59, 0.69, uv.y) * (1.0 - smoothstep(0.965, 1.0, uv.y));\n    float floor_center = source + travel * 0.34;\n    float floor_d = abs(uv.x - floor_center);\n    float floor_hotspot = (1.0 - smoothstep(0.12, 0.30, floor_d)) * floor_gate;\n\n    float wall_gate = smoothstep(0.49, 0.54, uv.y) * (1.0 - smoothstep(0.62, 0.68, uv.y));\n    float wall_center = source + travel * 0.075;\n    float wall_patch = (1.0 - smoothstep(0.07, 0.18, abs(uv.x - wall_center))) * wall_gate;\n\n    float intensity = (beams * 0.72 + floor_hotspot * 0.72 + wall_patch * 0.30) * strength;\n    COLOR = vec4(tint.rgb * intensity, clamp(intensity, 0.0, 1.0));\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_sun"]
